{
  "name": "Order Schema",
  "enforcement": "strict",
  "strict": false,
  "fields": {
    "customerEmail": {
      "type": "string",
      "required": true,
      "description": "Customer Email"
    },
    "totalAmount": {
      "type": "number",
      "required": true,
      "min": 0,
      "description": "Total Order Price"
    },
    "status": {
      "type": "string",
      "required": true,
      "enum": [
        "pending",
        "processing",
        "completed",
        "cancelled"
      ],
      "default": "pending",
      "description": "Order Status"
    },
    "itemCount": {
      "type": "number",
      "min": 1,
      "default": 1,
      "description": "Number of items"
    }
  }
}